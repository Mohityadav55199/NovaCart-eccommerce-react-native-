# ========================================================
# NovaCart Local Environment Configuration Guide
# ========================================================
# NovaCart consists of 3 parts: backend, admin, and mobile.
# Each subfolder has its own .env file used during development.
#
# 1. Backend:  backend/.env  (Express API on http://localhost:3000)
# 2. Admin:    admin/.env    (Vite Dashboard on http://localhost:5173)
# 3. Mobile:   mobile/.env   (Expo React Native App)
#
# Run all three locally with:
#   npm run dev
# ========================================================

# --- BACKEND (backend/.env) ---
# NODE_ENV=development
# PORT=3000
# DB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/novacart?retryWrites=true&w=majority
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# CLERK_WEBHOOK_SIGNING_SECRET=whsec_...
# INNGEST_SIGNING_KEY=signkey-test
# CLOUDINARY_API_KEY=...
# CLOUDINARY_API_SECRET=...
# CLOUDINARY_CLOUD_NAME=...
# ADMIN_EMAIL=your-email@example.com
# CLIENT_URL=http://localhost:5173
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# --- ADMIN (admin/.env) ---
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# VITE_API_URL=http://localhost:3000/api
# VITE_SENTRY_DSN=

# --- MOBILE (mobile/.env) ---
# EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# EXPO_PUBLIC_API_URL=http://localhost:3000/api
# SENTRY_AUTH_TOKEN=
# EXPO_PUBLIC_SENTRY_DSN=
